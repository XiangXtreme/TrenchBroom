+#include "ui/ToolController.h"
+
+#include <cstdlib>
+#include <iostream>
+
+namespace tb::ui
+{
+TEST_CASE("Extrude drag profile", "[.][profile]")
+{
+  QTemporaryDir settingsDir;
+  REQUIRE(settingsDir.isValid());
+  QSettings::setDefaultFormat(QSettings::IniFormat);
+  QSettings::setPath(QSettings::IniFormat, QSettings::UserScope, settingsDir.path());
+  setPref(Preferences::DefaultPluginPaths, "");
+  setPref(Preferences::PythonPluginDirectories, "");
+  if (std::getenv("TB_PROFILE_STYLE"))
+  {
+    QString error;
+    REQUIRE(installApplicationStyle(*qApp, QStringLiteral("dark"), &error));
+  }
+  auto fixture = AppControllerFixture{};
+  auto& app = fixture.appController();
+  auto document = MapDocument::createDocument(
+                    app.environmentConfig(),
+                    mdl::QuakeGameInfo,
+                    mdl::MapFormat::Valve,
+                    vm::bbox3d{8192.0},
+                    app.taskManager(),
+                    app.glManager().resourceManager())
+                  | kdl::value();
+  auto* doc = document.get();
+  std::unique_ptr<MapWindow> window;
+  const std::string mode =
+    std::getenv("TB_PROFILE_MODE") ? std::getenv("TB_PROFILE_MODE") : "window";
+  if (mode != "model")
+  {
+    window = std::make_unique<MapWindow>(app, std::move(document));
+    window->setAttribute(Qt::WA_DontShowOnScreen);
+    window->resize(1440, 900);
+    window->switchToInspectorPage(InspectorPage::Outliner);
+    window->show();
+    QApplication::processEvents();
+  }
+  auto& map = doc->map();
+  deselectAll(map);
+  auto initial = map.worldNode().defaultLayer()->children();
+  if (!initial.empty())
+    removeNodes(map, initial);
+  const int count =
+    std::getenv("TB_PROFILE_BRUSHES") ? std::atoi(std::getenv("TB_PROFILE_BRUSHES")) : 1;
+  auto builder = mdl::BrushBuilder{map.worldNode().mapFormat(), map.worldBounds()};
+  std::vector<mdl::Node*> nodes;
+  for (int i = 0; i < count; ++i)
+  {
+    const auto x = double(i % 32) * 96.0, y = double(i / 32) * 96.0;
+    nodes.push_back(new mdl::BrushNode{
+      builder.createCuboid(
+        vm::bbox3d{{x - 32, y - 32, -32}, {x + 32, y + 32, 32}}, "__TB_empty")
+      | kdl::value()});
+  }
+  addNodes(map, {{map.worldNode().defaultLayer(), nodes}});
+  auto* brush = static_cast<mdl::BrushNode*>(nodes.front());
+  const auto pump = [&] {
+    if (window)
+    {
+      QApplication::processEvents();
+      // Optional framebuffer readback also forces an extra render. The main experiment
+      // disables it.
+      if (!std::getenv("TB_PROFILE_EVENTS_ONLY"))
+        for (auto* view : window->findChildren<MapViewBase*>())
+          if (view->isVisible())
+            view->grabFramebuffer();
+      QApplication::sendPostedEvents(nullptr, QEvent::DeferredDelete);
+    }
+  };
+  pump();
+  for (const std::string kind : {"normal", "outward", "inward"})
+  {
+    deselectAll(map);
+    selectNodes(map, {brush});
+    auto tool = ExtrudeTool{*doc};
+
+    if (map.grid().snap())
+      map.grid().toggleSnap();
+    const auto origin = vm::vec3d{0, -128, 128};
+    auto camera = gl::PerspectiveCamera{
+      90.0f,
+      1.0f,
+      8000.0f,
+      gl::Camera::Viewport{0, 0, 1440, 900},
+      vm::vec3f{origin},
+      vm::normalize(vm::vec3f{0, 128, -96}),
+      vm::vec3f{0, 0, 1}};
+    auto extrudeController = ExtrudeToolController3D{tool};
+    auto& controller = static_cast<ToolController&>(extrudeController);
+    auto input = InputState{0, 0};
+    input.setModifierKeys(
+      kind == "normal" ? ModifierKeys::Shift
+                       : ModifierKeys::Shift | ModifierKeys::CtrlCmd);
+    input.mouseDown(MouseButtons::Left);
+    const auto repick = [&](double delta) {
+      tb::profile::Scope p{"input.pick"};
+      auto ray = vm::ray3d{origin, vm::normalize(vm::vec3d{0, 0, 32 + delta} - origin)};
+      input.setPickRequest(PickRequest{ray, camera});
+      auto picked = mdl::PickResult::byDistance();
+      mdl::pick(map, ray, picked);
+      controller.pick(input, picked);
+      input.setPickResult(std::move(picked));
+    };
+    repick(0);
+    auto tracker = controller.acceptMouseDrag(input);
+    REQUIRE(tracker != nullptr);
+    REQUIRE(tool.proposedDragHandles().size() == 1);
+    input.setAnyToolDragging(true);
+    const auto step = [&](int i) {
+      const auto delta = (kind == "inward" ? -1.0 : 1.0) * double(8 + i % 16);
+      repick(delta);
+      REQUIRE(tracker->update(input));
+      const auto selected = map.selection().brushes;
+      REQUIRE(!selected.empty());
+      // Assert the controller actually applied this sample (and did not deny the drag).
+      auto* moving = kind == "normal" ? brush : selected.back();
+      REQUIRE(std::abs(moving->logicalBounds().max.z() - (32 + delta)) < 0.001);
+    };
+    for (int i = 0; i < 20; ++i)
+    {
+      step(i);
+      pump();
+    }
+    std::vector<std::array<double, 3>> samples;
+    samples.reserve(120);
+    tb::profile::values.clear();
+    tb::profile::enabled = true;
+    for (int i = 0; i < 120; ++i)
+    {
+
+      const auto begin = tb::profile::Clock::now();
+      tb::profile::Scope frame{"frame"};
+      {
+        tb::profile::Scope drag{"drag"};
+        step(i);
+      }
+      const auto afterDrag = tb::profile::Clock::now();
+      {
+        tb::profile::Scope events{"events_and_render"};
+        pump();
+      }
+      const auto end = tb::profile::Clock::now();
+      const auto ms = [](auto a, auto z) {
+        return std::chrono::duration<double, std::milli>(z - a).count();
+      };
+      samples.push_back({ms(begin, end), ms(begin, afterDrag), ms(afterDrag, end)});
+    }
+    tb::profile::enabled = false;
+    const auto output = std::string(std::getenv("TB_PROFILE_OUTPUT")) + "/" + mode + "-"
+                        + std::to_string(count) + "-" + kind + ".csv";
+
+    tb::profile::dump(output);
+    std::ofstream sampleFile(output + ".samples.csv");
+    sampleFile << "frame_ms,drag_ms,events_ms\n";
+    for (const auto& sample : samples)
+      sampleFile << sample[0] << ',' << sample[1] << ',' << sample[2] << '\n';
+    std::cout << output << " frame_ms=" << tb::profile::values["frame"].inclusive / 120.0
+              << '\n';
+    tracker->cancel();
+    pump();
+    REQUIRE(brush->logicalBounds() == vm::bbox3d{{-32, -32, -32}, {32, 32, 32}});
+    REQUIRE(map.worldNode().defaultLayer()->childCount() == size_t(count));
+  }
+}
