file(COPY "@TB_PYTHON_RUNTIME_LIBRARY@" DESTINATION "${TB_PYTHON_DEST}")
if(EXISTS "@TB_PYTHON_RUNTIME_DIR@/python3.dll")
    file(COPY "@TB_PYTHON_RUNTIME_DIR@/python3.dll" DESTINATION "${TB_PYTHON_DEST}")
endif()
file(COPY "@TB_PYTHON_STDLIB@/" DESTINATION "${TB_PYTHON_DEST}/python/Lib"
    PATTERN "site-packages" EXCLUDE
    PATTERN "__pycache__" EXCLUDE
    PATTERN "*.pyc" EXCLUDE)
file(COPY "@TB_PYTHON_RUNTIME_DIR@/DLLs/" DESTINATION "${TB_PYTHON_DEST}/python/DLLs"
    PATTERN "__pycache__" EXCLUDE
    PATTERN "*.pyc" EXCLUDE)
file(COPY "@TB_PYTHON_RUNTIME_DIR@/LICENSE.txt" DESTINATION "${TB_PYTHON_DEST}/python")
