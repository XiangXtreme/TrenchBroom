--- /dev/null
+++ b/lib/TbBaseLib/include/base/ExtrudeProfile.h
@@ -0,0 +1,66 @@
+
+#pragma once
+#include <chrono>
+#include <fstream>
+#include <iomanip>
+#include <map>
+#include <string>
+namespace tb::profile
+{
+using Clock = std::chrono::steady_clock;
+struct Value
+{
+  long long calls = 0;
+  double inclusive = 0, exclusive = 0;
+};
+inline thread_local bool enabled = false;
+inline thread_local std::map<std::string, Value> values;
+struct Scope;
+inline thread_local Scope* current = nullptr;
+struct Scope
+{
+  bool active;
+  const char* name;
+  Scope* parent;
+  Clock::time_point start;
+  double children = 0;
+  explicit Scope(const char* n)
+    : active(enabled)
+    , name(n)
+    , parent(current)
+  {
+    if (active)
+    {
+      current = this;
+      start = Clock::now();
+    }
+  }
+  ~Scope()
+  {
+    if (!active)
+      return;
+    const auto elapsed =
+      std::chrono::duration<double, std::milli>(Clock::now() - start).count();
+    auto& v = values[name];
+    ++v.calls;
+    v.inclusive += elapsed;
+    v.exclusive += elapsed - children;
+    if (parent)
+      parent->children += elapsed;
+    current = parent;
+  }
+};
+inline void dump(const std::string& path)
+{
+  std::ofstream out(path);
+  out << "scope,calls,inclusive_ms,exclusive_ms\n" << std::setprecision(12);
+  for (const auto& [name, v] : values)
+    out << name << ',' << v.calls << ',' << v.inclusive << ',' << v.exclusive << '\n';
+}
+template <class F>
+auto measure(const char* name, F&& f)
+{
+  Scope s(name);
+  return f();
+}
+} // namespace tb::profile
