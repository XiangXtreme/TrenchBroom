//* Like func_button, except it rotates.
@SolidClass base(Targetname, Global, Master, Target, Angles, RenderFields, ZHLT, TexLightType) = func_rot_button : "旋转按钮手柄" 
[
	delay(string) : "触发延迟时间(秒)" : "0"
	//* changetarget will change the button's target's TARGET field to the button's changetarget when button is pressed.
	changetarget(target_destination) : "ChangeTarget Name"
	speed(integer) : "移动速度" : 50
	health(integer) : "生命值/破坏耐久" : 0
	//* The number against each sound corresponds to the wav file
	//* played. e.g. Squeaky (1) plays "buttons/lever1.wav".
	sounds(choices) : "音效方案预设" : 21 = 
	[
		21: "Squeaky"

		22: "Squeaky Pneumatic"

		23: "Ratchet Groan"

		24: "Clean Ratchet"

		25: "Gas Clunk"

	]
	wait(choices) : "自动复位延迟(秒)" : 3 =
	[
		-1: "Stays pressed"

		 3: "3 sec default"

	]
	distance(integer) : "Distance (deg)" : 90
	spawnflags(flags) =
	[
		1 : "Not solid" : 0

		2 : "Reverse Dir" : 0

		32: "可切换开关状态" : 0

		64: "X Axis" : 0

		128: "Y Axis" : 0

		256:"玩家触碰立即激活": 0

	]
	_minlight(string) : "Minimum light level" : "0"
]

@SolidClass base(Targetname, Global, Angles, RenderFields, ZHLT, TexLightType) = func_rotating : "持续旋转风扇/轮子"
[
	speed(integer)	: "移动速度" : 0
	volume(integer) : "Volume (10 = loudest)" : 10
	fanfriction(integer) : "Friction (0 - 100%)" : 20
	//* The number against each sound corresponds to the wav file
	//* played. e.g. Slow Rush (2) plays "fans/fan2.wav".	
	sounds(choices) : "音效方案预设" : "" =
	[
		"" : "No Sound" 

		1 : "Fast Whine"

		2 : "Slow Rush"

		3 : "Medium Rickety"

		4 : "Fast Beating"

		5 : "Slow Smooth"

	]
	//* The sound to play while active. This will only be used if "Fan Sounds" is set to "No Sound".
	message(sound) : "提示文本/音效路径"
	spawnflags(flags) =
	[
		1 : "Start ON" 		: 0

		2 : "Reverse Direction" : 0

		4 : "X Axis" 		: 0

		8 : "Y Axis" 		: 0

		16: "Acc/Dcc"		: 0

		32: "Fan Pain"		: 0

		64: "Not Solid"		: 0

		//* This and the other "radius" settings, only affect the
		//* way the Fan Sounds are played; if you set a small radius,
		//* the sounds will only be audible near to the fan.
		128: "Small Radius" : 0

		256: "Medium Radius" : 0

		512: "Large Radius" : 1	

	]
	_minlight(string) : "Minimum light level" : "0"
//*	_minlight(integer) : "_minlight" : 0
	spawnorigin(string) : "X Y Z - Move here after lighting" : "0 0 0"
	dmg(integer) : "伤害数值" : 0
]

