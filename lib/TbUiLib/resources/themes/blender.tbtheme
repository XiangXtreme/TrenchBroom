{
  "schemaVersion": 1,
  "id": "builtin.blender",
  "name": "Blender",
  "author": "Blender Foundation / TrenchBroom",
  "appearance": "dark",
  "inherits": "builtin.dark",
  "colors": {
    "editorBackground": "#27282b",
    "sidebarBackground": "#252629",
    "panelBackground": "#2b2d31",
    "elevatedBackground": "#303236",
    "inputBackground": "#35373c",
    "alternateBackground": "#24262a",
    "buttonBackground": "#35373c",
    "hoverBackground": "#3a3c40",
    "pressedBackground": "#4c3a2e",
    "selectionBackground": "#554032",
    "inactiveSelectionBackground": "#42382f",
    "border": "#3c3e43",
    "strongBorder": "#505257",
    "focusBorder": "#ea832f",
    "text": "#d4d6da",
    "secondaryText": "#a3a6ad",
    "disabledText": "#72767e",
    "accent": "#ea832f",
    "error": "#ef7065",
    "warning": "#e3b266",
    "success": "#71b86c",
    "windowBackground": "#202124",
    "inverseText": "#fff0e3"
  }
}
