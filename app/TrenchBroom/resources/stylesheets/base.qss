QMainWindow,
QDialog {
  background: @tb-window-background;
  color: @tb-text;
}

QMenuBar {
  background: @tb-window-background;
  border-bottom: 1px solid @tb-border;
  color: @tb-text;
  padding: 1px 4px;
  spacing: 2px;
}

QMenuBar::item {
  background: transparent;
  border-radius: 4px;
  padding: 4px 7px;
}

QMenuBar::item:selected {
  background: @tb-hover-background;
}

QMenuBar::item:pressed {
  background: @tb-pressed-background;
}

QMenu {
  background: @tb-elevated-background;
  border: 1px solid @tb-strong-border;
  border-radius: 6px;
  color: @tb-text;
  padding: 4px;
}

QMenu::item {
  border-radius: 4px;
  padding: 4px 28px 4px 8px;
}

QMenu::item:selected {
  background: @tb-selection-background;
  color: @tb-inverse-text;
}

QMenu::item:checked {
  background: @tb-pressed-background;
}

QMenu::item:checked:selected {
  background: @tb-selection-background;
}

QMenu::item:disabled {
  color: @tb-disabled-text;
}

QMenu::item:disabled:selected {
  background: @tb-hover-background;
  color: @tb-disabled-text;
}

QMenu::indicator {
  height: 16px;
  width: 16px;
}

QMenu::separator {
  background: @tb-border;
  height: 1px;
  margin: 4px 6px;
}

QToolBar {
  background: @tb-panel-background;
  border: none;
  border-bottom: 1px solid @tb-border;
  padding: 2px 4px;
  spacing: 2px;
}

QToolBar QToolButton {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 5px;
  padding: 3px;
}

QToolBar QToolButton:hover {
  background: @tb-hover-background;
  border-color: @tb-border;
}

QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
  background: @tb-pressed-background;
  border-color: @tb-strong-border;
}

QToolBar QToolButton:disabled {
  color: @tb-disabled-text;
}

QToolBar#MapWindowToolBar {
  background: @tb-window-background;
  border: none;
  padding: 4px 6px;
  spacing: 3px;
}

QToolBar#MapWindowToolBar QToolButton {
  min-height: 26px;
  min-width: 26px;
  padding: 0;
}

QToolBar#MapWindowToolBar::separator {
  background: @tb-border;
  margin: 5px 4px;
  width: 1px;
}

QWidget#MapWindow_WorkbenchShell {
  background: @tb-window-background;
}

/* All pane corners use one antialiased frame, including OpenGL viewports. */
QWidget[tbSurfaceFrame="true"] {
  qproperty-cornerRadius: 6;
  qproperty-borderWidth: 1;
  qproperty-borderColor: @tb-border;
  qproperty-activeBorderColor: @tb-accent;
  qproperty-outsideColor: @tb-window-background;
}

QWidget#MapWindow_EditorSurface,
QWidget#MapViewAreaSurface {
  background: @tb-window-background;
}

QWidget#MapWindow_InfoPanelSurface {
  background: @tb-panel-background;
}

QWidget#MapWindow_InspectorSurface {
  background: @tb-sidebar-background;
}

QLabel#WorkbenchPanelTitle,
QLabel[regionAnchor="true"],
QWidget[regionAnchorTabs="true"] QLabel#TabBarButtonLabel {
  color: @tb-secondary-text;
  font-size: 11px;
  font-weight: bold;
}

QLabel#WorkbenchPanelTitle,
QLabel#Inspector_PageTitle {
  background: @tb-sidebar-background;
  padding: 0 10px;
}

QLabel#Inspector_PageTitle {
  color: @tb-text;
  background: @tb-elevated-background;
  border-bottom: 1px solid @tb-border;
}

QWidget#Inspector_PageContainer,
QWidget#Inspector_TabBook {
  background: @tb-sidebar-background;
}

QWidget#Inspector_NavigationRail {
  background: @tb-sidebar-background;
  border-right: 1px solid @tb-border;
}

/* Navigation shares one state language across inspector rails and tool drawers. */
QToolButton[tbControlRole="navigation"] {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 4px;
  color: @tb-secondary-text;
  min-height: 24px;
  padding: 1px 7px;
}

QToolButton[tbControlRole="navigation"]:hover {
  background: @tb-hover-background;
  border-color: @tb-border;
  color: @tb-text;
}

QToolButton[tbControlRole="navigation"]:checked {
  background: @tb-pressed-background;
  border-color: @tb-strong-border;
  color: @tb-accent;
}

QToolButton[tbControlRole="navigation"]:focus {
  border-color: @tb-focus-border;
}

QToolButton[tbControlRole="navigation"]:disabled {
  color: @tb-disabled-text;
}

QWidget#Inspector_NavigationRail QToolButton[tbControlRole="navigation"] {
  min-width: 0;
  padding: 0;
}

QWidget#ProjectWorkspaceTabs,
QWidget#ProjectToolBar {
  background: @tb-sidebar-background;
  border-bottom: 1px solid @tb-border;
}

QWidget#ProjectToolBar {
  background: @tb-elevated-background;
  border-top: 1px solid @tb-border;
  border-bottom: 1px solid @tb-border;
}

/* Horizontal drawer navigation is one compound tab strip. */
QWidget#ProjectToolBar QToolButton[tbControlRole="navigation"] {
  border-radius: 4px;
  border-bottom: 2px solid transparent;
}

QWidget#ProjectToolBar QToolButton[tbControlRole="navigation"]:checked {
  background: @tb-button-background;
  border-color: @tb-strong-border;
  border-bottom-color: @tb-accent;
  color: @tb-text;
}

QWidget#ProjectToolBar QToolButton[tbControlRole="navigation"]:focus {
  border-left-color: @tb-focus-border;
  border-right-color: @tb-focus-border;
  border-top-color: @tb-focus-border;
}

QWidget#ProjectToolBar QToolButton[tbControlRole="navigation"]:disabled {
  color: @tb-disabled-text;
  border-color: transparent;
}

QWidget#WorkspaceStatusBar {
  background: @tb-sidebar-background;
  border-top: 1px solid @tb-border;
}

QWidget#WorkspaceStatusBar QLabel[tbStatus="saved"] {
  color: @tb-success;
}

QWidget#WorkspaceStatusBar QLabel[tbStatus="modified"] {
  color: @tb-warning;
}

QFrame#ProjectToolDrawer {
  background: @tb-panel-background;
  border: 1px solid @tb-border;
  border-radius: 6px;
}

QWidget#WorkspaceDrawerResize {
  background: transparent;
}

QWidget#WorkspaceDrawerGrip {
  background: @tb-strong-border;
  border-radius: 1px;
}

QWidget#WorkspaceDrawerResize:hover QWidget#WorkspaceDrawerGrip {
  background: @tb-accent;
}

QPushButton {
  background: @tb-button-background;
  border: 1px solid @tb-strong-border;
  border-radius: 6px;
  color: @tb-text;
  min-height: 22px;
  padding: 2px 8px;
}

QPushButton:hover {
  background: @tb-hover-background;
}

QPushButton:pressed,
QPushButton:checked {
  background: @tb-pressed-background;
}

QPushButton:focus,
QPushButton:default {
  border-color: @tb-focus-border;
}

QPushButton:disabled {
  color: @tb-disabled-text;
}

QToolButton {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 5px;
  color: @tb-text;
  min-height: 22px;
  min-width: 22px;
  padding: 2px;
}

QToolButton:hover {
  background: @tb-hover-background;
  border-color: @tb-border;
}

QToolButton:focus {
  border-color: @tb-focus-border;
}

QToolButton:pressed,
QToolButton:checked {
  background: @tb-pressed-background;
  border-color: @tb-strong-border;
}

QToolButton:disabled {
  color: @tb-disabled-text;
}

QToolButton[tbControlRole="compact"] {
  border-radius: 4px;
  min-height: 18px;
  min-width: 18px;
  padding: 0;
}

QToolButton[tbControlRole="outlined"] {
  background: transparent;
  border-color: @tb-border;
}

/* A labelled control that sits next to fields: outlined like a field, but with room for
   an icon and a word. */
QToolButton[tbControlRole="chip"] {
  background: transparent;
  border: 1px solid @tb-border;
  border-radius: 5px;
  min-height: 22px;
  padding: 0 8px;
}

/* Solid surface keeps controls readable above map grids and rendered images. */
QToolButton[tbControlRole="overlay"] {
  background: @tb-elevated-background;
  border-color: @tb-border;
  border-radius: 4px;
  min-height: 22px;
  padding: 2px 6px;
}

QToolButton[tbControlRole="overlay"]::menu-indicator {
  subcontrol-origin: border;
  subcontrol-position: right center;
}

/* Reserve the split menu area when Qt lays out the button label. */
QToolButton[tbControlRole="overlay"][popupMode="1"] {
  padding-right: 21px;
}

QToolButton[tbControlRole="overlay"]::menu-button {
  subcontrol-origin: padding;
  subcontrol-position: right center;
  width: 18px;
  border-left: 1px solid @tb-border;
}

QToolButton[tbControlRole="overlay"]::menu-arrow {
  image: @tb-combo-arrow-image;
  width: 12px;
  height: 12px;
}

QToolButton[tbControlRole="outlined"]:hover,
QToolButton[tbControlRole="outlined"]:focus,
QToolButton[tbControlRole="overlay"]:hover,
QToolButton[tbControlRole="overlay"]:focus {
  background: @tb-hover-background;
  border-color: @tb-focus-border;
}

QToolButton[tbControlRole="outlined"]:pressed,
QToolButton[tbControlRole="outlined"]:checked,
QToolButton[tbControlRole="overlay"]:pressed,
QToolButton[tbControlRole="overlay"]:checked {
  background: @tb-pressed-background;
  border-color: @tb-strong-border;
}

QGroupBox {
  background: transparent;
  border: 1px solid @tb-border;
  border-radius: 6px;
  color: @tb-text;
  margin-top: 8px;
  padding: 8px 6px 6px 6px;
}

QGroupBox::title {
  color: @tb-secondary-text;
  left: 8px;
  padding: 0 4px;
  subcontrol-origin: margin;
  subcontrol-position: top left;
}

QGroupBox:disabled,
QGroupBox::title:disabled {
  color: @tb-disabled-text;
}

QWidget#DialogButtonBar {
  background: @tb-panel-background;
}

QLineEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox {
  background: @tb-input-background;
  border: 1px solid @tb-border;
  border-radius: 4px;
  color: @tb-text;
  min-height: 22px;
  padding: 1px 5px;
  selection-background-color: @tb-selection-background;
  selection-color: @tb-inverse-text;
}

QLineEdit QToolButton {
  background: transparent;
  border: none;
  border-radius: 3px;
  margin: 0;
  min-height: 0;
  min-width: 0;
  padding: 0;
}

QLineEdit QToolButton:hover {
  background: @tb-hover-background;
  border: none;
}

QLineEdit QToolButton:pressed {
  background: @tb-pressed-background;
  border: none;
}

QTextEdit,
QPlainTextEdit {
  background: @tb-input-background;
  border: 1px solid @tb-border;
  border-radius: 4px;
  color: @tb-text;
  padding: 4px 5px;
  selection-background-color: @tb-selection-background;
  selection-color: @tb-inverse-text;
}

QLineEdit:read-only,
QTextEdit[readOnly="true"],
QPlainTextEdit[readOnly="true"] {
  background: @tb-panel-background;
  color: @tb-secondary-text;
}

QComboBox {
  border-radius: 4px;
  padding: 1px 7px;
}

QComboBox:editable {
  min-width: 64px;
}

QComboBox::drop-down {
  background: transparent;
  border: none;
  subcontrol-origin: padding;
  subcontrol-position: top right;
  width: 22px;
}

QComboBox::down-arrow {
  height: 12px;
  image: @tb-combo-arrow-image;
  width: 12px;
}

QComboBox::down-arrow:disabled {
  image: @tb-combo-arrow-disabled-image;
}

QSpinBox,
QDoubleSpinBox {
  padding-right: 24px;
}

/* Dense stacked vector channels share the canonical numeric states. */
QDoubleSpinBox[tbControlRole="vector"] {
  background: @tb-button-background;
  min-height: 20px;
  padding: 0 5px;
  border-radius: 0;
}

QDoubleSpinBox[tbControlRole="vector"][tbVectorPosition="first"] {
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
}

QDoubleSpinBox[tbControlRole="vector"][tbVectorPosition="last"] {
  border-bottom-left-radius: 4px;
  border-bottom-right-radius: 4px;
}

QDoubleSpinBox[tbControlRole="vector"][multiSelected="true"] {
  border-color: @tb-focus-border;
  background: @tb-hover-background;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button {
  background: transparent;
  border: none;
  border-left: 1px solid @tb-border;
  subcontrol-origin: border;
  width: 19px;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
  border-bottom: 1px solid @tb-border;
  border-top-right-radius: 3px;
  subcontrol-position: top right;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
  border-bottom-right-radius: 3px;
  subcontrol-position: bottom right;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow,
QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
  height: 8px;
  width: 8px;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
  image: @tb-spin-up-arrow-image;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
  image: @tb-combo-arrow-image;
}

QSpinBox::up-arrow:disabled,
QDoubleSpinBox::up-arrow:disabled {
  image: @tb-spin-up-arrow-disabled-image;
}

QSpinBox::down-arrow:disabled,
QDoubleSpinBox::down-arrow:disabled {
  image: @tb-combo-arrow-disabled-image;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
  background: @tb-hover-background;
}

QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed {
  background: @tb-pressed-background;
}

QSpinBox::up-button:disabled,
QDoubleSpinBox::up-button:disabled,
QSpinBox::down-button:disabled,
QDoubleSpinBox::down-button:disabled {
  background: transparent;
}

QComboBox QAbstractItemView {
  background: @tb-elevated-background;
  border: 1px solid @tb-strong-border;
  border-radius: 8px;
  color: @tb-text;
  outline: none;
  padding: 4px;
  selection-background-color: @tb-selection-background;
  selection-color: @tb-inverse-text;
}

QComboBox QAbstractItemView::item {
  border: 1px solid transparent;
  border-radius: 4px;
  min-height: 22px;
  padding: 1px 6px;
}

QComboBox QAbstractItemView::item:hover {
  background: @tb-hover-background;
}

QComboBox QAbstractItemView::item:selected {
  background: @tb-selection-background;
  color: @tb-inverse-text;
}

QCheckBox,
QRadioButton {
  color: @tb-text;
  min-height: 20px;
  spacing: 7px;
}

QCheckBox:disabled,
QRadioButton:disabled {
  color: @tb-disabled-text;
}

QLineEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
  border-color: @tb-strong-border;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
  border-color: @tb-focus-border;
}

QLineEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
  background: @tb-window-background;
  color: @tb-disabled-text;
}

QSlider::groove:horizontal {
  background: @tb-border;
  border: none;
  border-radius: 2px;
  height: 4px;
}

QSlider::sub-page:horizontal {
  background: @tb-accent;
  border-radius: 2px;
}

QSlider::handle:horizontal {
  background: @tb-button-background;
  border: 1px solid @tb-strong-border;
  border-radius: 6px;
  margin: -5px 0;
  width: 12px;
}

QSlider::handle:horizontal:hover,
QSlider::handle:horizontal:focus {
  background: @tb-hover-background;
  border-color: @tb-focus-border;
}

QSlider::groove:horizontal:disabled,
QSlider::sub-page:horizontal:disabled {
  background: @tb-border;
}

QSlider::handle:horizontal:disabled {
  background: @tb-window-background;
  border-color: @tb-border;
}

QAbstractItemView {
  alternate-background-color: @tb-alternate-background;
  background: @tb-editor-background;
  border: none;
  color: @tb-text;
  outline: none;
  selection-background-color: @tb-selection-background;
  selection-color: @tb-inverse-text;
}

QAbstractItemView::item {
  border: 1px solid transparent;
}

QAbstractItemView::item:hover {
  background: @tb-hover-background;
}

QAbstractItemView::item:selected {
  background: @tb-selection-background;
  color: @tb-inverse-text;
}

QAbstractItemView::item:selected:!active {
  background: @tb-inactive-selection-background;
}

QAbstractItemView::item:focus {
  border-color: @tb-focus-border;
}

QAbstractItemView:disabled {
  background: @tb-panel-background;
  color: @tb-disabled-text;
}

QAbstractItemView::item:disabled {
  color: @tb-disabled-text;
}

QTreeView::item,
QListView::item {
  border-radius: 4px;
  min-height: 22px;
  padding: 1px 4px;
}

/* A tree row is one surface, including all indentation levels. */
QTreeView::item {
  border-radius: 0;
}

QListView[tbControlRole="suggest-popup"] {
  background: @tb-panel-background;
  border: 1px solid @tb-border;
  border-radius: 6px;
  padding: 2px;
}

QTableView {
  border: none;
  gridline-color: @tb-border;
}

QListWidget {
  border: none;
}

QHeaderView::section {
  background: @tb-panel-background;
  border: none;
  border-bottom: 1px solid @tb-border;
  border-right: 1px solid @tb-border;
  color: @tb-secondary-text;
  min-height: 22px;
  padding: 2px 6px;
}

QHeaderView::section:hover {
  background: @tb-hover-background;
  color: @tb-text;
}

QHeaderView::section:pressed,
QHeaderView::section:checked {
  background: @tb-pressed-background;
  color: @tb-text;
}

QHeaderView::section:disabled {
  color: @tb-disabled-text;
}

QTabWidget::pane {
  border: 1px solid @tb-border;
  border-radius: 6px;
}

QTabBar::tab {
  background: @tb-panel-background;
  border: 1px solid transparent;
  border-radius: 5px;
  color: @tb-secondary-text;
  margin: 3px 2px;
  min-height: 26px;
  padding: 0 10px;
}

QTabBar::tab:hover {
  background: @tb-hover-background;
  color: @tb-text;
}

QTabBar::tab:selected {
  background: @tb-editor-background;
  border-color: @tb-border;
  color: @tb-text;
}

QTabBar::tab:focus {
  border-color: @tb-focus-border;
}

QTabBar::tab:disabled {
  background: transparent;
  color: @tb-disabled-text;
}

QTabBar::close-button {
  image: @tb-tab-close-image;
}

QTabBar::close-button:hover {
  image: @tb-tab-close-hover-image;
}

QWidget#TabBarButton {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 6px;
}

QWidget#TabBarButton:hover {
  background: @tb-hover-background;
}

QWidget#TabBarButton[active="true"] {
  background: @tb-pressed-background;
  border-color: @tb-border;
}

QWidget#TabBarButton QLabel#TabBarButtonLabel {
  color: @tb-secondary-text;
}

QWidget#TabBarButton[active="true"] QLabel#TabBarButtonLabel {
  color: @tb-text;
  font-weight: bold;
}

QWidget#InfoPanel_TabBook,
QWidget#InfoPanel_Console,
QWidget#InfoPanel_PythonConsole,
QWidget#InfoPanel_Issues,
QWidget#InfoPanel_Assets {
  background: @tb-panel-background;
}

QWidget#InfoPanel_TabBar {
  background: @tb-panel-background;
  border-bottom: 1px solid @tb-border;
}

QWidget#InfoPanel_TabBar QWidget#TabBarButton {
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  border-radius: 0;
}

QWidget#InfoPanel_TabBar QWidget#TabBarButton:hover,
QWidget#InfoPanel_TabBar QWidget#TabBarButton:focus {
  background: @tb-hover-background;
}

QWidget#InfoPanel_TabBar QWidget#TabBarButton[active="true"] {
  background: transparent;
  border-bottom-color: @tb-accent;
}

QWidget#InfoPanel_TabBar QWidget#TabBarButton[active="true"] QLabel#TabBarButtonLabel {
  color: @tb-text;
  font-weight: bold;
}

QTextEdit#Console_TextView,
QTextEdit#PythonConsole_Output {
  background: @tb-editor-background;
  border: none;
  color: @tb-text;
  padding: 5px 7px;
  selection-background-color: @tb-selection-background;
  selection-color: @tb-inverse-text;
}

QTextEdit#PythonConsole_Output {
  padding: 7px 12px 0 12px;
}

QWidget#PythonConsole_InputBar {
  background: @tb-editor-background;
  border: none;
}

QLabel#PythonConsole_Prompt {
  color: @tb-accent;
  padding-top: 2px;
}

QPlainTextEdit#PythonConsole_Input {
  background: @tb-editor-background;
  border: none;
  border-radius: 0;
  color: @tb-text;
  padding: 2px 0;
  selection-background-color: @tb-selection-background;
  selection-color: @tb-inverse-text;
}

QPlainTextEdit#PythonConsole_Input:focus {
  border: none;
}

QWidget#PythonConsole_TabActions {
  background: transparent;
}

QWidget#PythonConsole_TabActions QToolButton {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 3px;
  color: @tb-secondary-text;
  min-height: 22px;
  padding: 1px 7px;
}

QWidget#PythonConsole_TabActions QToolButton:hover,
QWidget#PythonConsole_TabActions QToolButton:focus {
  background: @tb-hover-background;
  border-color: @tb-border;
  color: @tb-text;
}

QWidget#PythonConsole_TabActions QToolButton:pressed {
  background: @tb-pressed-background;
  border-color: @tb-strong-border;
}

QWidget#PythonConsole_TabActions QToolButton:disabled {
  background: transparent;
  border-color: transparent;
  color: @tb-disabled-text;
}

QWidget#IssueBrowser_TabActions {
  background: transparent;
}

QWidget#IssueBrowser_TabActions QCheckBox {
  color: @tb-secondary-text;
  spacing: 5px;
}

QTableView#IssueBrowser_Table {
  background: @tb-editor-background;
  border: none;
  padding: 2px;
}

QWidget#ModelBrowser_Controls {
  background: @tb-panel-background;
  border-bottom: 1px solid @tb-border;
}

QWidget#EntityBrowser_Controls,
QWidget#MaterialBrowser_Controls {
  background: @tb-panel-background;
  border-bottom: 1px solid @tb-border;
}

QWidget#EntityBrowser_FilterRow,
QWidget#MaterialBrowser_FilterRow {
  background: transparent;
}

QToolButton[browserFilterToggle="true"] {
  background: @tb-button-background;
  border: 1px solid @tb-border;
  border-radius: 5px;
  color: @tb-secondary-text;
  min-height: 24px;
  min-width: 48px;
  padding: 0 7px;
}

QToolButton[browserFilterToggle="true"]:hover {
  background: @tb-hover-background;
  border-color: @tb-strong-border;
  color: @tb-text;
}

QToolButton[browserFilterToggle="true"]:focus {
  border-color: @tb-focus-border;
}

QToolButton[browserFilterToggle="true"]:pressed,
QToolButton[browserFilterToggle="true"]:checked {
  background: @tb-pressed-background;
  border-color: @tb-focus-border;
  color: @tb-text;
}

QWidget#ModelBrowser_BreadcrumbBar {
  background: transparent;
  border: none;
}

/* Path crumbs are navigation targets, so they stay at full text contrast; only the
   separators recede. */
QWidget#ModelBrowser_BreadcrumbBar QToolButton {
  color: @tb-text;
  font-weight: 600;
  padding: 0 4px;
}

QWidget#ModelBrowser_BreadcrumbBar QToolButton:hover,
QWidget#ModelBrowser_BreadcrumbBar QToolButton:focus {
  background: @tb-hover-background;
  border-radius: 4px;
}

QLabel[breadcrumbSeparator="true"] {
  color: @tb-secondary-text;
}

/* Popovers are their own windows, so they paint the full surface with a border instead
   of relying on a rounded mask that would show the window background in the corners. */
QWidget#ModelBrowser_FilterPopup,
QWidget#ModelBrowser_ViewPopup {
  background: @tb-panel-background;
  border: 1px solid @tb-border;
}

QWidget#ModelBrowser_FilterPopup QLabel,
QWidget#ModelBrowser_ViewPopup QLabel {
  color: @tb-secondary-text;
}

QWidget#ModelBrowser_ResultBar {
  background: @tb-panel-background;
  border-bottom: 1px solid @tb-border;
}

QLabel#ModelBrowser_ResultCount {
  color: @tb-secondary-text;
}

QTreeWidget#ModelBrowser_FolderTree {
  background: @tb-panel-background;
  border: none;
  min-width: 170px;
  padding: 3px;
}

QSplitter#ModelBrowser_Splitter::handle {
  background: @tb-border;
  width: 1px;
}

QStatusBar {
  background: @tb-window-background;
  border: none;
  border-top: 1px solid @tb-border;
  color: @tb-secondary-text;
  min-height: 24px;
  padding: 0 4px;
}

QStatusBar::item {
  border: none;
}

QStatusBar QLabel#MapWindow_StatusLabel,
QStatusBar QLabel {
  color: @tb-secondary-text;
}

QStatusBar QToolButton[tbControlRole="compact"] {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 4px;
  color: @tb-secondary-text;
  min-height: 20px;
  padding: 0 6px;
}

QStatusBar QToolButton[tbControlRole="compact"]:hover {
  background: @tb-hover-background;
  border-color: @tb-border;
  color: @tb-text;
}

QStatusBar QToolButton[tbControlRole="compact"]:focus {
  border-color: @tb-focus-border;
}

QStatusBar QToolButton[tbControlRole="compact"]:checked {
  background: @tb-pressed-background;
  border-color: @tb-accent;
  color: @tb-text;
}

QStatusBar QComboBox[tbControlRole="compact"] {
  background: transparent;
  border-color: transparent;
  color: @tb-secondary-text;
  min-height: 20px;
  min-width: 72px;
  padding: 0 5px;
}

QStatusBar QComboBox[tbControlRole="compact"]:hover {
  background: @tb-hover-background;
  border-color: @tb-border;
  color: @tb-text;
}

QStatusBar QComboBox[tbControlRole="compact"]:focus {
  border-color: @tb-focus-border;
}

QDialog#CommandPalette_Dialog {
  background: @tb-elevated-background;
}

QDialog#PreferenceDialog_Dialog {
  background: @tb-editor-background;
}

QWidget#PreferenceDialog_Navigation {
  background: @tb-sidebar-background;
  border-right: 1px solid @tb-border;
}

QLabel#PreferenceDialog_NavigationTitle {
  min-height: 22px;
  padding: 0 7px;
}

QListWidget#PreferenceDialog_NavigationList {
  background: transparent;
  border: none;
  outline: none;
  padding: 0;
}

QListWidget#PreferenceDialog_NavigationList::item {
  background: transparent;
  border: 1px solid transparent;
  border-left: 2px solid transparent;
  border-radius: 5px;
  color: @tb-secondary-text;
  min-height: 34px;
  padding: 2px 7px;
}

QListWidget#PreferenceDialog_NavigationList::item:hover {
  background: @tb-hover-background;
  color: @tb-text;
}

QListWidget#PreferenceDialog_NavigationList::item:selected,
QListWidget#PreferenceDialog_NavigationList::item:selected:!active {
  background: @tb-pressed-background;
  border-left-color: @tb-accent;
  color: @tb-text;
}

QWidget#PreferenceDialog_Content,
QStackedWidget#PreferenceDialog_Pages,
QWidget#PreferencePane,
QWidget#PreferencePane_Content {
  background: @tb-editor-background;
}

QLabel#PreferenceDialog_PageTitle {
  background: @tb-panel-background;
  border-bottom: 1px solid @tb-border;
  color: @tb-text;
  font-size: 16px;
  font-weight: bold;
  min-height: 44px;
  padding: 0 16px;
}

QScrollArea#PreferencePane_ScrollArea {
  background: @tb-editor-background;
  border: none;
}

QLineEdit[tbControlRole="prominent"] {
  background: @tb-input-background;
  border: 1px solid @tb-strong-border;
  border-radius: 6px;
  min-height: 30px;
  padding: 1px 8px;
}

QListWidget#CommandPalette_ActionList {
  background: @tb-panel-background;
  border: 1px solid @tb-border;
  border-radius: 6px;
  padding: 3px;
}

QListWidget#CommandPalette_ActionList::item {
  border: none;
  border-radius: 4px;
  min-height: 38px;
  padding: 3px 7px;
}

QListWidget#CommandPalette_ActionList::item:hover {
  background: @tb-hover-background;
}

QListWidget#CommandPalette_ActionList::item:selected {
  background: @tb-selection-background;
  color: @tb-inverse-text;
}

QToolTip {
  background: @tb-elevated-background;
  border: 1px solid @tb-strong-border;
  color: @tb-text;
  border-radius: 5px;
  padding: 3px 5px;
}

QScrollBar:vertical {
  background: @tb-panel-background;
  border: none;
  margin: 0;
  width: 10px;
}

QScrollBar:horizontal {
  background: @tb-panel-background;
  border: none;
  height: 10px;
  margin: 0;
}

QScrollBar::handle {
  background: @tb-disabled-text;
  border-radius: 5px;
  min-height: 24px;
  min-width: 24px;
}

QScrollBar::handle:hover {
  background: @tb-secondary-text;
}

QScrollBar::handle:pressed {
  background: @tb-text;
}

QScrollBar:disabled {
  background: transparent;
}

QScrollBar::handle:disabled {
  background: @tb-border;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
  background: transparent;
  border: none;
  height: 0;
  width: 0;
}

QSplitter::handle {
  background: @tb-border;
}

QSplitter::handle:hover {
  background: @tb-secondary-text;
}

QSplitter::handle:pressed {
  background: @tb-accent;
}

QSplitter#MapWindow_HorizontalSplitter::handle,
QSplitter#MapWindow_VerticalSplitterSplitter::handle {
  background: transparent;
}

QListWidget#controlListBox_listWidget {
  border: none;
}

QWidget#OutlinerInspector_Toolbar {
  background: @tb-sidebar-background;
  border-bottom: 1px solid @tb-border;
}

QTreeWidget#OutlinerTreeWidget {
  background: @tb-sidebar-background;
  border: none;
  padding: 3px 2px 5px 2px;
}

QTreeWidget#OutlinerTreeWidget::item {
  background: transparent;
  border: none;
  min-height: 24px;
  padding: 0 3px;
}

QTreeWidget#OutlinerTreeWidget::item:hover,
QTreeWidget#OutlinerTreeWidget::item:selected,
QTreeWidget#OutlinerTreeWidget::item:selected:!active {
  background: transparent;
}

QHeaderView#OutlinerTreeHeader::section {
  background: @tb-sidebar-background;
  border: none;
  border-bottom: 1px solid @tb-border;
  color: @tb-secondary-text;
  min-height: 25px;
  padding: 0 5px;
}

QSplitter#OutlinerInspector_Splitter::handle {
  background: @tb-border;
  height: 5px;
}

QWidget#FaceAttribsEditor,
QWidget#UvEditor,
QWidget#MaterialBrowser {
  background: @tb-panel-background;
}

QWidget#UvEditor_Toolbar {
  background: @tb-panel-background;
  border-top: 1px solid @tb-border;
  padding: 3px 0;
}

QWidget#FaceAttribsEditor_Tools {
  background: @tb-sidebar-background;
}

QWidget#FaceAttribsEditor_Attributes {
  background: @tb-panel-background;
}

QWidget#FaceAttribsEditor_Attributes QLabel[faceFieldLabel="true"] {
  color: @tb-secondary-text;
  font-weight: normal;
}

QLabel#FaceAttribsEditor_MaterialName {
  color: @tb-text;
  font-weight: bold;
}

QWidget#FaceAttribsEditor_Attributes QDoubleSpinBox {
  min-width: 70px;
}

QWidget#ClickableTitleBar {
  background: @tb-alternate-background;
  border: 1px solid transparent;
  border-radius: 4px;
  min-height: 26px;
}

QWidget#ClickableTitleBar:hover {
  background: @tb-hover-background;
}

QWidget#ClickableTitleBar:focus {
  border-color: @tb-focus-border;
}

QWidget#ClickableTitleBar QLabel#ClickableTitleBar_Title {
  color: @tb-text;
}

QWidget#ClickableTitleBar QLabel#ClickableTitleBar_StateText {
  color: @tb-secondary-text;
}

QWidget#ClickableTitleBar QLabel#ClickableTitleBar_Title:disabled,
QWidget#ClickableTitleBar QLabel#ClickableTitleBar_StateText:disabled {
  color: @tb-disabled-text;
}

QWidget#ClickableTitleBar QToolButton[tbControlRole="compact"] {
  background: transparent;
  border: none;
  border-radius: 5px;
  padding: 0;
}

QWidget#ClickableTitleBar QToolButton[tbControlRole="compact"]:hover {
  background: @tb-pressed-background;
}

QWidget#PluginInspector_PluginPanel {
  background: @tb-elevated-background;
  border: 1px solid @tb-strong-border;
  border-radius: 6px;
}

QWidget#PluginInspector_PluginPanel:hover {
  border-color: @tb-focus-border;
}

QWidget#PluginInspector_PluginPanel > QWidget#ClickableTitleBar {
  background: @tb-button-background;
  border: none;
  border-top-left-radius: 5px;
  border-top-right-radius: 5px;
}

QWidget#PluginInspector_PluginPanel > QFrame {
  background: @tb-border;
  border: none;
  min-height: 1px;
  max-height: 1px;
}

QWidget#PluginInspector_PluginPanel > QWidget {
  background: @tb-panel-background;
  border: none;
  border-bottom-left-radius: 5px;
  border-bottom-right-radius: 5px;
}

QWidget#TransformCard,
QWidget#EntityPropertyCard {
  background: @tb-alternate-background;
  border: 1px solid @tb-border;
  border-radius: 6px;
}

QWidget#TransformCard > QWidget#ClickableTitleBar,
QWidget#EntityPropertyCard > QWidget#ClickableTitleBar {
  background: transparent;
  border: none;
}

QWidget#TransformCard > QFrame,
QWidget#EntityPropertyCard > QFrame {
  background: transparent;
  border: none;
  min-height: 0;
  max-height: 0;
}

QWidget#TransformCard > QWidget,
QWidget#EntityPropertyCard > QWidget {
  background: transparent;
  border: none;
}

QLabel[tbTextRole="secondary"] {
  color: @tb-secondary-text;
}

tb--ui--BitmapButton {
  border: none;
}

tb--ui--BitmapButton::menu-indicator {
  image: none;
}

QScrollArea#outlinerPropertyScrollArea {
  background: transparent;
}

QWidget#OutlinerPropertyPanel {
  background: @tb-sidebar-background;
}

QWidget#OutlinerPropertySectionHeader {
  background: @tb-panel-background;
  min-height: 26px;
}

QWidget#OutlinerPropertySectionHeader QLabel {
  color: @tb-secondary-text;
}

QWidget#OutlinerPropertyPanelBody {
  background: @tb-sidebar-background;
}

QWidget#outlinerPropertyList {
  background: @tb-editor-background;
}

QLabel#outlinerPropertySelectionSummary {
  background: @tb-editor-background;
  border-bottom: 1px solid @tb-border;
  color: @tb-text;
  padding: 4px 8px;
}

QWidget#outlinerPropertyAddBar {
  background: transparent;
  border-top: 1px solid @tb-border;
}

/* Asset library browser: list and tree controls keep the canonical styling; only the
   structural containers and labels carry the panel treatment. */
QWidget#AssetLibraryHeader {
  background: @tb-panel-background;
  border-bottom: 1px solid @tb-border;
}

QLabel#AssetLibraryBadge {
  background: @tb-elevated-background;
  border: 1px solid @tb-border;
  border-radius: 8px;
}

QLabel#AssetLibraryHeaderTitle {
  color: @tb-text;
  font-size: 15px;
  font-weight: 600;
}

QLabel#AssetLibraryHeaderPath {
  color: @tb-secondary-text;
  font-size: 11px;
}

QLabel#AssetLibraryChip {
  background: @tb-alternate-background;
  border: 1px solid @tb-border;
  border-radius: 9px;
  color: @tb-secondary-text;
  font-size: 10px;
  font-weight: 600;
  padding: 2px 9px;
}

QLabel#AssetLibraryChip[libraryState="local"] {
  color: @tb-success;
}

QLabel#AssetLibraryChip[libraryState="remote"] {
  color: @tb-accent;
}

QLabel#AssetLibraryChip[libraryState="none"] {
  color: @tb-disabled-text;
}

QFrame#AssetLibrarySeparator {
  background: @tb-border;
  border: 0;
  max-width: 1px;
}

QWidget#AssetLibrarySidebar {
  background: @tb-sidebar-background;
  border-right: 1px solid @tb-border;
}

QWidget#AssetLibraryCenter {
  background: @tb-window-background;
}

QWidget#AssetLibraryInspector {
  background: @tb-panel-background;
  border-left: 1px solid @tb-border;
}

QLabel#AssetLibrarySectionTitle {
  color: @tb-secondary-text;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1px;
  padding-top: 2px;
}

QLabel#AssetLibraryCount {
  color: @tb-secondary-text;
}

QLabel#AssetLibrarySizeLabel,
QLabel#AssetLibrarySizeValue {
  color: @tb-secondary-text;
}

QLabel#AssetLibraryPreview {
  background: @tb-editor-background;
  border: 1px solid @tb-border;
  border-radius: 6px;
  color: @tb-secondary-text;
}

QLabel#AssetLibraryEmpty {
  color: @tb-secondary-text;
}

QLabel#AssetLibraryFooter {
  background: @tb-panel-background;
  border-top: 1px solid @tb-border;
  color: @tb-secondary-text;
}

QLabel#AssetLibraryAssetName {
  color: @tb-text;
  font-weight: 600;
}

QLabel#AssetLibraryStatus {
  color: @tb-secondary-text;
}

QLabel#AssetLibraryPropertyKey {
  color: @tb-secondary-text;
}

QLabel#AssetLibraryPropertyValue {
  color: @tb-text;
}

QListWidget#AssetLibraryGrid {
  background: @tb-window-background;
  border: 0;
  qproperty-readyColor: @tb-success;
  qproperty-pendingColor: @tb-warning;
  qproperty-missingColor: @tb-error;
}

QListWidget#AssetLibraryCategories,
QListWidget#AssetLibraryDependencies {
  background: transparent;
  border: 0;
}

QListWidget#AssetLibraryCategories {
  qproperty-readyColor: @tb-success;
  qproperty-pendingColor: @tb-warning;
  qproperty-missingColor: @tb-error;
}

QWidget#outlinerPropertyRow {
  background: transparent;
  border: none;
  border-radius: 5px;
}

QWidget#outlinerPropertyRow:hover {
  background: @tb-hover-background;
}

QWidget#outlinerPropertyRow[inactive="true"] {
  background: transparent;
}

QWidget#outlinerPropertyKey QLabel {
  color: @tb-secondary-text;
}

QWidget#outlinerPropertyKey[inactive="true"] QLabel {
  color: @tb-secondary-text;
}

QWidget#outlinerPropertyRow[inactive="true"] QLineEdit,
QWidget#outlinerPropertyRow[inactive="true"] QComboBox {
  background: @tb-window-background;
  border-color: @tb-border;
}

QWidget#smartSkyboxHeader {
  background: transparent;
}

QLabel#smartSkyboxTitle {
  color: @tb-text;
  font-weight: bold;
}

QListWidget#smartSkyboxList {
  background: transparent;
  outline: none;
}

QLabel#McpSettings_Error {
  color: @tb-error;
}

QTextBrowser[pluginPanelOutput="true"] {
  background: transparent;
  border: none;
}

QFrame#smartFaceSelectionPanel {
  background: @tb-window-background;
  border: 1px solid @tb-border;
  border-radius: 6px;
}

QFrame#smartFaceSelectionPanel QLabel {
  background: transparent;
  border: none;
}

QFrame#smartFaceSelectionPanel QToolButton {
  min-height: 24px;
  min-width: 24px;
}

/* Asset browser compound surfaces use the shared controls and theme palette. */
QWidget#ModelBrowser_Sources,
QWidget#ProjectAssetDetailsSurface {
  background: @tb-sidebar-background;
}

QWidget#ModelBrowser_Sources > QLabel[regionAnchor="true"],
QWidget#ProjectAssetDetailsSurface > QLabel[regionAnchor="true"] {
  min-height: 30px;
  padding: 0 10px;
  background: @tb-panel-background;
  border-bottom: 1px solid @tb-border;
}

QScrollArea#AssetInspector_Scroll {
  background: transparent;
  border: none;
}

QTreeWidget#ProjectAssetDetails {
  background: @tb-sidebar-background;
  border: none;
}
