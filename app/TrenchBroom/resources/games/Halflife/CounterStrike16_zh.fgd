[
	angles(string) : "三维朝向角度 (Pitch Yaw Roll)" : "0 270 0"
	pitch(integer) : "垂直仰角 (Pitch)" : -90
//Shade is used only by Adam Foster's hack of HLRAD to vary the color of shade.
	_diffuse_light(color255) : "Shade" : "255 255 128 200"
]

@PointClass base(Targetname, Target, Angles, Light) iconsprite("sprites/CS/LightSpot.spr") = light_spot : "定向聚光灯" 
[
	pitch(integer) : "垂直仰角 (Pitch)" : -90
	_cone(integer) : "Inner (bright) angle" : 30
	_cone2(integer) : "Outer (fading) angle" : 45
	_sky(Choices) : "天际漫反射光 (Ambient Sky)" : "" = 
	[ 
		"" : "否"

		1 : "是"

	]
]

//* ------------------------------------------------------------------------------------------------------------
//* Triggers a sequence of up to 16 entities, at various time offsets.
//*   To specify the list of entities for it to trigger, turn off Worldcraft's "smart edit" mode
//* and add fields manually. The name of the field is the targetname of the entity to trigger,
//* and the contents of the field are the time (in seconds) to wait before triggering it.
//* 
//*  Beware: the seconds countdown will continue thru round ends causing some events to happen into the next round.
//*------------------------------------------------------------------------------------------------------------
@PointClass base(Targetname) color(255 128 0) size(-16 -16 -16, 16 16 16) iconsprite("editor/multi_manager.png") = multi_manager : "多重目标延迟触发器"
[
	spawnflags(Flags) = 
	[
		//* By default, a manager will ignore all inputs while it's performing a sequence.
		//* Tick this to allow more than one sequence to run at a time.
		1 : "multithreaded" : 0

	]
]

//*
//*multiple inputs to one switch, the AND gate
//*
@PointClass base(Targetname, Target) color(128 255 128) iconsprite("sprites/CS/MultiSource.spr") = multisource : "多源逻辑与门" 
[
	globalstate(string) : "Global State Master"
]

@PointClass base(Targetname, Angles) size(16 16 16) color(247 181 82) iconsprite("sprites/CS/PathCorner.spr") = path_corner : "路径巡航拐角节点"
[
	spawnflags(Flags) =
	[
		1: "Wait for retrigger" : 0

		2: "Teleport to next corner" : 0

		4: "Fire once" : 0

	]
	target(target_destination) : "触发目标"
	message(target_destination) : "提示文本/音效路径"
	wait(integer) : "自动复位延迟(秒)" : 0
//*if speed more than 2000 problems may result
	speed(integer) : "移动速度" : 0
	yaw_speed(integer) : "New Train rot. Speed" : 0
]

@PointClass base(Targetname) size(16 16 16) iconsprite("sprites/CS/PathTrack.spr") = path_track : "列车轨道控制节点"
[
	target(target_destination) : "触发目标"
	spawnflags(Flags) =
	[
		1: "Disabled" : 0

		2: "Fire once" : 0

		4: "Branch Reverse" : 0

		8: "Disable train" : 0

	]
	message(target_destination) : "提示文本/音效路径"
	altpath(target_destination) : "Branch Path"
	netname(target_destination) : "路径目标"
//if speed more than 2000 problems may result
	speed(integer) : "移动速度" : 0
]

